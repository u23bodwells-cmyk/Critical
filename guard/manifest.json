{
  "manifest_version": 3,
  "name": "Critical Guard",
  "version": "1.1.0",
  "description": "Closes TikTok in Chrome from 4:45 pm until today's Critical plan is done, then opens it back up.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["*://*.tiktok.com/*", "*://tiktok.com/*"],
  "externally_connectable": { "matches": ["https://u23bodwells-cmyk.github.io/*", "http://localhost/*"] },
  "background": { "service_worker": "bg.js" },
  "action": { "default_popup": "popup.html", "default_title": "Critical Guard", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "web_accessible_resources": [{ "resources": ["closed.html"], "matches": ["<all_urls>"] }]
}
