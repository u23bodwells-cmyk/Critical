{
  "manifest_version": 3,
  "name": "Critical Focus",
  "version": "1.5",
  "description": "Strict mode for Critical: at plan time TikTok gets closed and blocked, and Critical stays on your chosen screen until today's plan is done. Plus one button (or Alt+Shift+C) to set up your study screens.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "system.display",
    "declarativeNetRequest",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://u23bodwells-cmyk.github.io/*"
    ]
  },
  "action": {
    "default_title": "Critical Focus",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "page.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "open-critical": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Critical: close TikTok, Critical on your study screen, the Claude app, SoundCloud on your music screen"
    }
  }
}